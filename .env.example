# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag_curriculum

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=curriculum

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# LLM backend: "anthropic" | "groq" | "gemini" | "ollama" | "router"
# Use "anthropic" for the bulk contextualize run (fast, ~$1 per 10k chunks).
LLM_BACKEND=anthropic

# Anthropic API (paid). Key: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=type api key here
ANTHROPIC_MODEL=claude-haiku-5-5

# Let router mode fall back to Anthropic too. Off by default so the free-tier
# path never spends money by accident. Ignored when LLM_BACKEND=anthropic.
LLM_ROUTER_USE_ANTHROPIC=false

# Gemini API
GEMINI_API_KEY=type api key here
GEMINI_MODEL=gemini-1.5-flash

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# Retrieval params
TOP_K_DENSE=30
TOP_K_BM25=30
TOP_K_RERANK=5
MULTI_QUERY_VARIANTS=3

# Ingest concurrency for the contextualize stage.
# Ollama: 1-2. Anthropic: 30-50 (this is what makes it minutes, not hours).
CONTEXTUALIZE_WORKERS=40

# Pipeline behaviour
ENABLE_CONTEXTUAL_RETRIEVAL=true
ENABLE_MULTI_QUERY=true
ENABLE_RERANK=true

# Optional: Langfuse tracing
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
