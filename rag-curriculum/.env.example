# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_DB=rag_curriculum

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=curriculum

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu

# Retrieval params
TOP_K_DENSE=30
TOP_K_BM25=30
TOP_K_RERANK=5
MULTI_QUERY_VARIANTS=3

# Pipeline behaviour
ENABLE_CONTEXTUAL_RETRIEVAL=true
ENABLE_MULTI_QUERY=true
ENABLE_RERANK=true

# Optional: Langfuse tracing
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
